  "narrative": {
    "northStar": "The Race Scoreboard",
    "overview": "DB Speed reads like the board at a regatta finish: dark, loud where it counts, and legible from a distance. The week number is the biggest thing on the Today screen, the season is a bar of 32 lit cells, and a logged set turns green like a result going up. An athlete between sets should get what they need in one glance, with a sweaty thumb, without reading a sentence.\n\nThe system is dense but calm. Condensed uppercase type carries the numbers and labels, a plain humanist body carries the sentences, and everything sits in one phone-width column. Colour is rationed and means something: red says what is current or what to press, green says done, amber says caution or target, blue says rest and focus.\n\nDepth is flat and firm. Surfaces separate by tone and a thin border, and controls feel solid rather than floating. The join and privacy pages share the same fonts, palette and card language, so the public pages and the app read as one product.",
    "keyCharacteristics": [
      "Numbers are the heroes: condensed, heavy, tabular.",
      "One phone-width column with a sticky top bar and fixed bottom tabs.",
      "Flat tonal layers with hairline borders.",
      "One accent per screen, with colour used for status rather than decoration.",
      "Uppercase condensed labels for structure, sentence-case Barlow for reading."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Each screen has a single accent colour: Finish-Line Red, or the team's accent when one applies. Never add a second brand colour.",
        "section": "colors"
      },
      {
        "name": "The Fill And Text Rule",
        "body": "A colour used as a fill and as text needs both roles to pass 4.5:1. Use accent or rest for fills and accent-text or blue for text.",
        "section": "colors"
      },
      {
        "name": "The Colour Means Status Rule",
        "body": "Green, amber and blue always carry their meaning. Never use them to decorate.",
        "section": "colors"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Every number that changes or lines up in a column uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Condensed uppercase labels and counts. Barlow explains. Never set a sentence in uppercase condensed type.",
        "section": "typography"
      },
      {
        "name": "The Flat-And-Firm Rule",
        "body": "Cards and buttons never cast a shadow at rest. If it does not float over content, it stays flat. Selection is shown with a border or a 1px ring, not with lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do make the number the largest thing on any screen that has a key number.",
      "Do keep all text contrast at 4.5:1 or better, in all three skins and with team accents, and tap targets at 44px or larger.",
      "Do keep every app screen within the 540px single column.",
      "Do use the stylesheet's colour variables, so skins and team accents keep working.",
      "Do check new work in French too, since it runs longer in uppercase condensed labels.",
      "Do switch off motion for people who ask for reduced motion, as the app does today."
    ],
    "donts": [
      "Don't add a second accent colour or use status colours as decoration.",
      "Don't put shadows on cards or buttons.",
      "Don't use a font other than Barlow and Barlow Condensed.",
      "Don't make Lake or Daylight the design reference. Scoreboard is the system.",
      "Don't add a colour swap other than the team accent.",
      "Don't dim text with opacity. Show locked or past items with Weathered Grey instead."
    ]
  }
}
